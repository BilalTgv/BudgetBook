@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">BudgetBook</h1>
    <p class="fs-5">deine persönliche ein und ausgabenverwaltung</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-controller="Transactions" asp-action="Index" class="btn btn-primary btn-lg">
                Meine Buchungen
            </a>
            <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-primary btn-lg">
                Statistik
            </a>
            <a asp-controller="Transactions" asp-action="Create" class="btn btn-outline-secondary btn-lg">
                Neue Buchung
            </a>
        </div>

        <div class="text-center mt-3">
            <button id="benotung-btn" class="btn btn-warning btn-lg" style="min-width: 340px;">
                Benotung
            </button>
        </div>
    }
    else
    {
        <p class="mt-4">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg">Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">Registrieren</a>
        </p>
    }
</div>

<div id="benotung-area" class="text-center mt-4" style="display:none;">
    <p class="fs-5">welche note möchtest du haben</p>
    <div class="d-flex justify-content-center gap-2 mb-4">
        <button class="btn btn-outline-dark note-btn" data-note="1">1</button>
        <button class="btn btn-outline-dark note-btn" data-note="2">2</button>
        <button class="btn btn-outline-dark note-btn" data-note="3">3</button>
        <button class="btn btn-outline-dark note-btn" data-note="4">4</button>
        <button class="btn btn-outline-dark note-btn" data-note="5">5</button>
    </div>

    <div id="cat-scene" class="position-relative mx-auto" style="width: 280px; height: 280px; margin-top: 360px;">
        <img id="reward-gif" src="~/images/belohnung-static.png" alt="belohnung"
             style="position:absolute; top:0; left:0; width:280px; height:280px; object-fit:cover; z-index:1;" />

        <img id="rock" src="~/images/fels.png" alt="fels"
             style="position:absolute; top:-340px; left:-30px; width:340px; z-index:2;" />
    </div>

    <p id="benotung-text" class="fs-5 fw-bold mt-5"></p>
</div>

<canvas id="confetti-canvas"
        style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; display:none;"></canvas>

<style>
    #rock {
        transition: transform 0.6s cubic-bezier(.55,0,.85,.6);
        pointer-events: none;
    }

    #rock.fall {
        transform: translateY(340px) rotate(8deg);
    }

    #rock.gone {
        transition: transform 0.5s ease, opacity 0.5s ease;
        opacity: 0;
        transform: translateY(-20px) scale(0.5);
    }

    #cat-scene.shake {
        animation: shake 0.3s ease 0.55s;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
    }
</style>

@section Scripts {
    <script>
        // zeigt die 5 buttons an wenn man auf benotung drückt
        document.getElementById('benotung-btn')?.addEventListener('click', function () {
            document.getElementById('benotung-area').style.display = 'block';
            this.style.display = 'none';
        });

        document.querySelectorAll('.note-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var note = this.getAttribute('data-note');
                var rock = document.getElementById('rock');
                var scene = document.getElementById('cat-scene');
                var text = document.getElementById('benotung-text');

                // buttons sperren damit man nicht mehrfach drücken kann
                document.querySelectorAll('.note-btn').forEach(function (b) { b.disabled = true; });

                if (note === '1') {
                    // note 1 ausgewählt, felsen verschwindet und konfetti kommt
                    rock.classList.add('gone');
                    text.textContent = 'na wenn du meinst...';
                    launchConfetti();
                    playRewardGif();
                } else {
                    // alles andere, der felsen fällt auf die katze runter
                    rock.classList.add('fall');
                    setTimeout(function () {
                        scene.classList.add('shake');
                    }, 550);
                    text.textContent = 'die katze hatte andere pläne für deine note';
                }
            });
        });

        // spielt das gif ab, läuft danach einfach endlos weiter (loop)
        function playRewardGif() {
            var gif = document.getElementById('reward-gif');
            // cache buster am ende der url, damit der browser die gif
            // wirklich neu lädt und von frame 1 an abspielt
            gif.src = '/images/belohnung.gif?t=' + Date.now();
        }

        // einfaches konfetti ohne externe bibliothek, nur canvas
        function launchConfetti() {
            var canvas = document.getElementById('confetti-canvas');
            canvas.style.display = 'block';
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            var ctx = canvas.getContext('2d');

            var farben = ['#ff595e', '#ffca3a', '#8ac926', '#1982c4', '#6a4c93'];
            var teilchen = [];
            for (var i = 0; i < 120; i++) {
                teilchen.push({
                    x: Math.random() * canvas.width,
                    y: -20 - Math.random() * canvas.height * 0.5,
                    groesse: 4 + Math.random() * 5,
                    farbe: farben[Math.floor(Math.random() * farben.length)],
                    geschwindigkeit: 2 + Math.random() * 4,
                    drehung: Math.random() * 360,
                    drehgeschwindigkeit: (Math.random() - 0.5) * 10
                });
            }

            var start = Date.now();
            function frame() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                var fertig = true;
                teilchen.forEach(function (t) {
                    t.y += t.geschwindigkeit;
                    t.drehung += t.drehgeschwindigkeit;
                    if (t.y < canvas.height + 20) {
                        fertig = false;
                    }
                    ctx.save();
                    ctx.translate(t.x, t.y);
                    ctx.rotate(t.drehung * Math.PI / 180);
                    ctx.fillStyle = t.farbe;
                    ctx.fillRect(-t.groesse / 2, -t.groesse / 2, t.groesse, t.groesse);
                    ctx.restore();
                });
                if (!fertig && Date.now() - start < 4000) {
                    requestAnimationFrame(frame);
                } else {
                    canvas.style.display = 'none';
                }
            }
            requestAnimationFrame(frame);
        }
    </script>
}
